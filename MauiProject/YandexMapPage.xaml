<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Emotional_Map.YandexMapPage"
             Title="Маршрут">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="0.3*" />
        </Grid.RowDefinitions>

        <!-- Верхняя часть с картой (70% экрана) -->
        <Grid Grid.Row="0">
            <WebView x:Name="MapWebView"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand"/>

            <!-- Индикатор загрузки -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="Blue"/>

            <!-- Кнопка назад -->
            <Button x:Name="BackButton"
                    Text="← Назад"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="10,10,0,0"
                    BackgroundColor="#EA4335"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="15,8"
                    WidthRequest="100"/>

            <!-- Кнопка для отладки -->
            <Button x:Name="DebugButton"
                    Text="Отладка"
                    IsVisible="False"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,10,10,0"
                    BackgroundColor="#80FFFFFF"
                    TextColor="Black"
                    FontSize="12"
                    CornerRadius="5"
                    Padding="5"/>
        </Grid>

        <!-- Нижняя часть с интерфейсом (30% экрана) -->
        <Grid Grid.Row="1" Padding="10" BackgroundColor="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопки для управления маршрутом -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Кнопка выбора района -->
                <Button x:Name="SelectDistrictButton"
                        Text="Выбрать район"
                        Grid.Column="0"
                        BackgroundColor="#4285F4"
                        TextColor="White"
                        CornerRadius="10"
                        Margin="5"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="16"/>

                <!-- Кнопка генерации случайного маршрута -->
                <Button x:Name="RandomRouteButton"
                        Text="Случайный маршрут"
                        Grid.Column="1"
                        BackgroundColor="#34A853"
                        TextColor="White"
                        CornerRadius="10"
                        Margin="5"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="16"/>
            </Grid>

            <!-- Кнопка построения маршрута (появляется после выбора района) -->
            <Button x:Name="BuildRouteButton"
                    Text="Построить маршрут"
                    Grid.Row="1"
                    BackgroundColor="#FBBC05"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    FontSize="16"
                    IsVisible="False"/>

            <!-- Информация о расстоянии маршрута -->
            <Label x:Name="RouteDistanceLabel"
                   Text="Расстояние: не определено"
                   Grid.Row="2"
                   TextColor="Black"
                   FontSize="14"
                   Margin="5,5,5,0"
                   IsVisible="False"/>

            <!-- Информация о времени в пути -->
            <Label x:Name="RouteDurationLabel"
                   Text="Время в пути: не определено"
                   Grid.Row="3"
                   TextColor="Black"
                   FontSize="14"
                   Margin="5,0,5,5"
                   IsVisible="False"/>

            <!-- Общая информация о маршруте -->
            <Label x:Name="RouteInfoLabel"
                   Text="Выберите район для построения маршрута"
                   Grid.Row="4"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"/>
        </Grid>
    </Grid>
</ContentPage>