<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Emotional_Map.YandexMapPage"
             Title="Карта маршрута"
             BackgroundColor="#E6F9FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Frame Grid.Row="0" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="20,15"
               HasShadow="True">
            <VerticalStackLayout>
                <Label x:Name="RouteTitle"
                       Text="Ваш персональный маршрут"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"/>
                <Label x:Name="RouteInfo"
                       Text="Загрузка информации о маршруте..."
                       FontSize="14"
                       TextColor="#666"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <WebView x:Name="MapWebView" 
                 Grid.Row="1"
                 BackgroundColor="White"/>

        <Frame Grid.Row="2" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="15,12"
               HasShadow="True"
               x:Name="NavigationFrame"
               IsVisible="False">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label x:Name="TotalDistanceLabel"
                           Text="Общее расстояние: 0 км"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#14D0FF"/>
                    <Label x:Name="TotalTimeLabel"
                           Text="Время: 0 мин"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#14D0FF"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label x:Name="PlacesCountLabel"
                           Text="Мест: 0"
                           FontSize="12"
                           TextColor="#666"/>
                    <Label x:Name="WalkTimeLabel"
                           Text="Ходьба: 0 мин"
                           FontSize="12"
                           TextColor="#666"/>
                    <Label x:Name="VisitTimeLabel"
                           Text="Посещение: 0 мин"
                           FontSize="12"
                           TextColor="#666"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="3" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="20,12"
               HasShadow="True"
               x:Name="RouteButtonFrame">
            <VerticalStackLayout Spacing="10">
                <Button x:Name="BuildRouteButton"
                        Text="🗺️ Проложить маршрут"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="#14D0FF"
                        TextColor="White"
                        CornerRadius="25"
                        Padding="20,15"
                        HorizontalOptions="FillAndExpand"
                        Clicked="OnBuildRouteClicked">
                    <Button.Shadow>
                        <Shadow Opacity="0.3" Radius="6" Offset="0, 4"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="4" 
               BackgroundColor="White" 
               CornerRadius="0" 
               Padding="20,15"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🏠 Главная"
                        FontSize="12"
                        BackgroundColor="#E6F9FF"
                        TextColor="Black"
                        CornerRadius="15"
                        Padding="10,8"
                        Clicked="OnHomeClicked">
                    <Button.Shadow>
                        <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                    </Button.Shadow>
                </Button>
                <Button Grid.Column="1"
                        Text="📍 GPS"
                        FontSize="12"
                        BackgroundColor="#14D0FF"
                        TextColor="White"
                        CornerRadius="15"
                        Padding="10,8"
                        Clicked="OnMyLocationClicked">
                    <Button.Shadow>
                        <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>