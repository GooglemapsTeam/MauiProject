<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Emotional_Map.EighthSurveyPage"
             Title="EighthSurveyPage"
             BackgroundColor="White">
    <Grid>
        <Image Source="stain.png" Aspect="AspectFit"/>

        <ScrollView>
            <Grid Padding="0, 20, 0, 20">
                <VerticalStackLayout VerticalOptions="Start" WidthRequest="300">
                    <Label Text="Давайте поможем вам найти идеальное место для хорошего настроения"
                           FontSize="20"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Какой район предпочитаете?"
                           FontSize="25"
                           TextColor="Black"
                           Margin="0, 40, 0, 0"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Button Text="Центр"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Верх-Исетский"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Ленинский"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Железнодорожный"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Кировский/Уралмаш"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Академический"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Чкаловский"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Орджоникидзевский"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="Не важно"
                                Clicked="OnAnswerSelected"
                                BackgroundColor="#E6F9FF"
                                TextColor="Black"
                                WidthRequest="300"
                                Margin="0, 20, 0, 0">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>