<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Emotional_Map.MainPage"
             Title="MainPage"
             BackgroundColor="#E6F9FF">
    <ScrollView>
        <VerticalStackLayout>
            <VerticalStackLayout Padding="20" HorizontalOptions="Center" VerticalOptions="Start" Spacing="15">

                <Label x:Name="WelcomeLabel" 
                       Text="Ваши рекомендации готовы!"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10"/>

                <Label Text="Основываясь на ваших ответах, мы подобрали идеальные места для улучшения настроения"
                       FontSize="14"
                       TextColor="#666"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,20"/>

                <VerticalStackLayout x:Name="RecommendationsContainer" Spacing="15">
                </VerticalStackLayout>

                <Frame x:Name="NoRecommendationsFrame" 
                       IsVisible="False"
                       BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="10"
                       Padding="20"
                       Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="К сожалению, мы не нашли подходящих мест по вашим критериям. Попробуйте пройти опрос заново с другими параметрами."
                               FontSize="14"
                               TextColor="#666"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="🔄 Пройти опрос заново"
                                FontSize="14"
                                BackgroundColor="#14D0FF"
                                TextColor="White"
                                CornerRadius="20"
                                Padding="15,10"
                                HorizontalOptions="Center"
                                Clicked="OnRetakeSurveyClicked">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="RetakeSurveyFrame" 
                       IsVisible="False"
                       BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="15"
                       Padding="20"
                       Margin="0,20,0,0"
                       WidthRequest="400">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Хотите получить новые рекомендации?"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Пройдите опрос заново, чтобы получить персонализированные рекомендации на основе вашего текущего настроения и предпочтений"
                               FontSize="14"
                               TextColor="#666"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="🔄 Пройти опрос заново"
                                FontSize="14"
                                BackgroundColor="#14D0FF"
                                TextColor="White"
                                CornerRadius="20"
                                Padding="20,12"
                                HorizontalOptions="Center"
                                Clicked="OnRetakeSurveyClicked">
                            <Button.Shadow>
                                <Shadow Opacity="0.25" Radius="4" Offset="0, 4"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>

            <Grid 
    HorizontalOptions="Center" 
    WidthRequest="400" 
    Padding="0,20" 
    VerticalOptions="End"
    ColumnSpacing="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Margin="40,0">
                    <Button 
            Text="★" FontSize="20" BackgroundColor="White" TextColor="Black" 
            WidthRequest="45" HeightRequest="45" CornerRadius="22" Clicked="OnFavouriteClicked">
                        <Button.Shadow>
                            <Shadow Opacity="0.25" Radius="4" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>
                    <Label Text="Избранное" FontSize="9" TextColor="Black" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Margin="40,0">
                    <Border 
            Stroke="Transparent" WidthRequest="45" HeightRequest="45" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Opacity="0.25" Radius="4" Offset="0,4"/>
                        </Border.Shadow>
                        <Image Aspect="AspectFill" x:Name="ProfileImage" Source="profile_button.png"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Label x:Name="HeaderLabel" Text="Профиль" FontSize="9" TextColor="Black" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="2" WidthRequest="0" IsVisible="False"/>

                
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Margin="40,0">
                    <Button 
            x:Name="ShowFullRouteButton" Text="🗺" FontSize="20" 
            BackgroundColor="White" TextColor="#14D0FF" 
            WidthRequest="45" HeightRequest="45" CornerRadius="22" 
            Clicked="OnShowFullRouteClicked" IsVisible="False">
                        <Button.Shadow>
                            <Shadow Opacity="0.25" Radius="4" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>
                    <Label Text="Весь маршрут" FontSize="9" TextColor="Black" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>